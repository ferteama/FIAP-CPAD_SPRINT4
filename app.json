{
  "expo": {
    "name": "Drone Vision Watch",
    "slug": "drone-vision-watch",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6FAF7"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "br.com.motiva.dronevisionwatch"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O app usa a galeria para anexar fotos do local da ocorrência.",
          "cameraPermission": "O app usa a câmera para registrar fotos do local da ocorrência."
        }
      ],
      "expo-router",
      "expo-build-properties",
      "expo-sharing"
    ],
    "ios": {
      "bundleIdentifier": "br.com.motiva.dronevisionwatch",
      "supportsTablet": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d6ebb451-f725-4b66-b4c5-4c697e268de9"
      }
    },
    "owner": "marcofonseca"
  }
}
